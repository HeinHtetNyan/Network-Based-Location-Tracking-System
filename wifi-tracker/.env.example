#  NetTrack — Environment Variables Template
#  Copy to .env and fill in your values before running.

# PostgreSQL credentials (used by both db and backend services)
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=wifi_tracker

# Full database URL consumed by the backend
# Format: postgresql://<user>:<password>@db:5432/<db_name>
DATABASE_URL=postgresql://your_db_user:your_strong_password@db:5432/wifi_tracker
